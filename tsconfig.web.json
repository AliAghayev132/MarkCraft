{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "paths": {
      "@shared": ["./src/shared/index.ts"],
      "@shared/*": ["./src/shared/*"],
      "@icons": ["./src/renderer/lib/icons.ts"],
      "@lib": ["./src/renderer/lib/index.ts"],
      "@lib/*": ["./src/renderer/lib/*"],
      "@components": ["./src/renderer/components/index.ts"],
      "@components/*": ["./src/renderer/components/*"],
      "@ui": ["./src/renderer/components/ui/index.ts"],
      "@ui/*": ["./src/renderer/components/ui/*"],
      "@features/*": ["./src/renderer/features/*"],
      "@hooks": ["./src/renderer/hooks/index.ts"],
      "@hooks/*": ["./src/renderer/hooks/*"],
      "@store": ["./src/renderer/store/index.ts"],
      "@store/*": ["./src/renderer/store/*"],
      "@services": ["./src/renderer/services/index.ts"],
      "@services/*": ["./src/renderer/services/*"],
      "@i18n": ["./src/renderer/i18n/index.ts"],
      "@i18n/*": ["./src/renderer/i18n/*"],
      "@styles/*": ["./src/renderer/styles/*"],
      "@utils": ["./src/renderer/utils/index.ts"],
      "@utils/*": ["./src/renderer/utils/*"]
    }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/renderer/env.d.ts"]
}
